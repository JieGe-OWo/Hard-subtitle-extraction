# 环境变量配置示例，复制为 .env 后按需修改
SECRET_KEY=please-change-me
ADMIN_EMAIL=zimuadminj8wfe@gmail.com
ADMIN_PASSWORD=Admin@123456

# 数据库（默认 MySQL，需先执行项目根目录 zimu.sql 建库建表；无 MySQL 时可改 sqlite）
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=zimu

# SMTP 邮件服务（不配置则为开发模式，验证码直接返回给前端）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USERNAME=your@email.com
# SMTP_PASSWORD=your-password
# SMTP_FROM=your@email.com
# SMTP_FROM_NAME=ZiMu字幕提取
# SMTP_SSL=1

# 允许的前端来源
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
